{
  "name": "CloudLess_Print_Bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Local bridge for 3D Print Service (Bambulab A1)",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev:video": "pnpm --filter @cloudless/video-service-hub start:dev",
    "dev:ftps": "pnpm --filter @cloudless/ftps-remote-manager start:dev",
    "dev:mqtt": "pnpm --filter @cloudless/mqtt-puppeteer start:dev",
    "dev:dashboard": "pnpm --filter @cloudless/octo-management-dashboard start",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "keywords": [
    "Bambulab A1",
    "3D Print Service",
    "Lan Only Mode"
  ],
  "author": "Robert Sereda",
  "license": "MIT",
  "type": "module"
}
