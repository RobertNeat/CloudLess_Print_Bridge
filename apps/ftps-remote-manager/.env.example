# Copy these values to the monorepo root .env file.
HOST=127.0.0.1
PORT=3000
FTP_HOST=192.168.1.100
FTP_PORT=990
FTP_USER=bblp
FTP_PASSWORD=replace-with-printer-lan-access-code
FTP_TLS_MODE=implicit
# SHA-256 fingerprint from a trusted FTPS client; colons are optional.
FTP_TLS_FINGERPRINT256=replace-with-64-hexadecimal-characters
FTP_TIMEOUT_MS=10000
FTP_MAX_CONCURRENT_SESSIONS=1
FTP_UPLOAD_MAX_BYTES=262144000
