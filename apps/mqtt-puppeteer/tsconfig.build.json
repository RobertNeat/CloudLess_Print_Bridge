{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Pin rootDir or tsc infers it from scripts/ and workspace .d.ts deps, emitting dist/src/main.js instead of dist/main.js
    "rootDir": "./src",
    // Keep inside dist/ so deleteOutDir wipes stale incremental cache instead of it silently emitting nothing
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": ["node_modules", "test", "dist", "scripts", "**/*spec.ts"]
}
