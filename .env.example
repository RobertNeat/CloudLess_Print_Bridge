# Shared authentication across all CloudLess backend services.
CLOUDLESS_AUTH_MODE=disabled
CLOUDLESS_AUTH_SHARED_SECRET=replace-with-at-least-32-random-characters
CLOUDLESS_AUTH_SERVICE_ORDER=mqtt-puppeteer,ftps-remote-manager,video-service-hub
CLOUDLESS_AUTH_TOKEN_TTL_SECONDS=86400

# MQTT Puppeteer service.
MQTT_PUPPETEER_HOST=0.0.0.0
MQTT_PUPPETEER_PORT=10220
MQTT_PUPPETEER_MQTT_HOST=192.168.0.0
MQTT_PUPPETEER_MQTT_PORT=8883
MQTT_PUPPETEER_MQTT_USERNAME=bblp
MQTT_PUPPETEER_MQTT_PASSWORD=replace-with-printer-lan-access-code
MQTT_PUPPETEER_PRINTER_SN=000000000000000
MQTT_PUPPETEER_MQTT_REJECT_UNAUTHORIZED=false
MQTT_PUPPETEER_MQTT_CONNECT_TIMEOUT_MS=10000
MQTT_PUPPETEER_MQTT_RECONNECT_PERIOD_MS=4000
MQTT_PUPPETEER_MQTT_KEEPALIVE_SECONDS=60
MQTT_PUPPETEER_OPERATION_TIMEOUT_MS=30000

# FTPS Remote Manager service.
FTPS_REMOTE_MANAGER_HOST=127.0.0.1
FTPS_REMOTE_MANAGER_PORT=10221
FTPS_REMOTE_MANAGER_FTP_HOST=192.168.1.100
FTPS_REMOTE_MANAGER_FTP_PORT=990
FTPS_REMOTE_MANAGER_FTP_USER=bblp
FTPS_REMOTE_MANAGER_FTP_PASSWORD=replace-with-printer-lan-access-code
FTPS_REMOTE_MANAGER_FTP_TLS_MODE=implicit
FTPS_REMOTE_MANAGER_FTP_TLS_FINGERPRINT256=replace-with-64-hexadecimal-characters
FTPS_REMOTE_MANAGER_FTP_TIMEOUT_MS=10000
FTPS_REMOTE_MANAGER_FTP_MAX_CONCURRENT_SESSIONS=1
FTPS_REMOTE_MANAGER_FTP_UPLOAD_MAX_BYTES=262144000

# Video Service Hub service.
VIDEO_SERVICE_HUB_HOST=0.0.0.0
VIDEO_SERVICE_HUB_PORT=10222
VIDEO_SERVICE_HUB_STORAGE_PATH=apps/video-service-hub/storage
VIDEO_SERVICE_HUB_CAPTURE_MAX_BYTES=20971520
VIDEO_SERVICE_HUB_RECORDING_PART_MAX_BYTES=16777216
VIDEO_SERVICE_HUB_AUDIO_MAX_BYTES=10485760
VIDEO_SERVICE_HUB_LIVE_MAX_BYTES=1073741824
VIDEO_SERVICE_HUB_LIVE_VIEWER_BUFFER_BYTES=2097152
VIDEO_SERVICE_HUB_CAMERA_COMMAND_TIMEOUT_MS=10000
VIDEO_SERVICE_HUB_MQTT_PORT=1883
VIDEO_SERVICE_HUB_MQTT_CONNECT_TIMEOUT_MS=10000
VIDEO_SERVICE_HUB_MQTT_RECONNECT_PERIOD_MS=1000
VIDEO_SERVICE_HUB_MQTT_CAMERA_ONLINE_TTL_MS=60000
